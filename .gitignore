# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Editor ───────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Environment Variables ────────────────────────────────────────────────────
# 각 모듈(.env.example)만 커밋. 실제 .env는 절대 커밋 금지.
.env
.env.*
!**/.env.example

# ─── Backend ──────────────────────────────────────────────────────────────────
backend/build/
backend/.gradle/
backend/bin/
backend/out/
backend/.idea/
# 환경변수 파일 (example 파일만 커밋)
backend/.env
backend/.env.*
!backend/.env.example
# Spring 설정 파일 (local만 ignore — prod yml은 시크릿이 모두 ${ENV} 참조라 안전)
backend/application-local.yml
backend/src/main/resources/application-local.yml
# Firebase service account key
backend/**/*-firebase-adminsdk-*.json
backend/**/firebase-credentials.json
backend/**/google-services.json
# Apple Sign In private key
backend/src/main/resources/apple-key.p8
# JVM crash logs
backend/hs_err_pid*.log
backend/replay_pid*.log

# ─── Frontend ─────────────────────────────────────────────────────────────────
# (세부 규칙은 frontend/.gitignore 참고)
frontend/node_modules/
frontend/.expo/
frontend/dist/
frontend/web-build/
# ios/android 디렉토리 자체는 유지 (FCM 설정 파일 보관용 — 세부 규칙은 frontend/.gitignore 참고)

.claude/*
marketing-screenshots/*
marketing/*


