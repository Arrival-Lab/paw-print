# ── Spring Profile ───────────────────────────────────────────
# local | prod
SPRING_PROFILES_ACTIVE=local

# ── Database ─────────────────────────────────────────────────
# 로컬 Docker 기본값 (docker-compose-local.yml 기준)
DB_URL=jdbc:postgresql://pawprint-db.cp5ajcba5ojx.ap-northeast-2.rds.amazonaws.com:5432/pawprintdb
DB_USER=pawprint_admin
DB_PASSWORD=

# ── Security ─────────────────────────────────────────────────
# 256bit(32자) 이상 랜덤 문자열. 운영 환경에서는 반드시 변경.
JWT_SECRET=

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://10.0.2.2:8081

# ── AWS ──────────────────────────────────────────────────────
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=pawprint-files
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# ── OAuth2 (Google) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Apple Sign-In ────────────────────────────────────────────
APPLE_KEY_ID=
APPLE_KEY_PATH=

# ── In-App Purchase (iOS) ────────────────────────────────────
# App Store Connect > 앱 > 인앱 구매 > 앱 공유 암호 (App-Specific Shared Secret)
APPLE_SHARED_SECRET=

# ── Firebase FCM ─────────────────────────────────────────────
# 서비스 계정 JSON 파일 경로
FCM_CREDENTIALS_PATH=

# ── AI / External APIs ───────────────────────────────────────
GEMINI_API_KEY=

# ── Payment (Google Play) ────────────────────────────────────
PLAY_DEVELOPER_API_JSON=

# ── Kakao Local API (응급병원 검색) ──────────────────────────
# 절대 프론트엔드에 노출 금지
KAKAO_API_KEY=
