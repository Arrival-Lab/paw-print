# 실제 값은 팀 채널 공유정보 참고

# ── Database ─────────────────────────────────────────────────
# 로컬 Docker 기본값 (docker-compose-local.yml 기준)
DB_URL=jdbc:postgresql://localhost:5432/pawprintdb
DB_USERNAME=dev
DB_PASSWORD=dev

# ── Security ─────────────────────────────────────────────────
# 256bit(32자) 이상 랜덤 문자열. 운영 환경에서는 반드시 변경.
JWT_SECRET=

# ── CORS ─────────────────────────────────────────────────────
# 쉼표 구분. 운영 환경에서는 실제 도메인으로 변경.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://10.0.2.2:8081

# ── AWS ──────────────────────────────────────────────────────
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=pawprint-files
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# ── OAuth2 — Google ───────────────────────────────────────────
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보
GOOGLE_CLIENT_ID=

# ── OAuth2 — Apple ────────────────────────────────────────────
# Apple Developer > Certificates > Keys
APPLE_KEY_ID=
# apple-key.p8 파일은 backend/src/main/resources/apple-key.p8 에 직접 저장

# ── Firebase FCM ─────────────────────────────────────────────
# Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
# 다운로드한 JSON 파일의 절대 경로
FCM_SERVICE_ACCOUNT_KEY=

# ── AI / OCR ─────────────────────────────────────────────────
# Google AI Studio > API 키
GEMINI_API_KEY=

# ── Kakao Local API (응급병원 검색) ───────────────────────────
# https://developers.kakao.com → 내 애플리케이션 → REST API 키
# 절대 프론트엔드에 노출 금지
KAKAO_API_KEY=

# ── In-App Purchase — iOS ─────────────────────────────────────
# App Store Connect > 앱 > 인앱 구매 > 앱 공유 암호
APPLE_SHARED_SECRET=

# ── In-App Purchase — Android ─────────────────────────────────
# Google Cloud Console > 서비스 계정 JSON 키 파일의 절대 경로
PLAY_DEVELOPER_API_JSON=
