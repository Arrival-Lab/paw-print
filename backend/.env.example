
# 실제 값은 Confluence > 공유정보 페이지 참고

# ── Database ─────────────────────────────────────────────────
# 로컬 Docker 기본값 (docker-compose-local.yml 기준)
DB_URL=jdbc:postgresql://localhost:5432/pawprintdb
DB_USERNAME=dev
DB_PASSWORD=dev

# ── Security ─────────────────────────────────────────────────
# 256bit(32자) 이상 랜덤 문자열. 운영 환경에서는 반드시 변경.
JWT_SECRET=
ENCRYPTION_KEY=

# ── AWS ──────────────────────────────────────────────────────
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# ── OAuth2 ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── Firebase FCM ─────────────────────────────────────────────
# Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
# 다운로드한 JSON 파일의 절대 경로를 입력
FCM_SERVICE_ACCOUNT_KEY=

# ── AI / External APIs ────────────────────────────────────────
DRUG_INFO_API_KEY=
GEMINI_API_KEY=

# ── Payment ───────────────────────────────────────────────────
PLAY_DEVELOPER_API_JSON=
APPLE_BUNDLE_ID=com.arrivallab.pawprint
APPLE_ENV=SANDBOX

# ── Kakao Local API (응급병원 검색) ───────────────────────────
# https://developers.kakao.com → 내 애플리케이션 → REST API 키
# 절대 프론트엔드에 노출 금지
KAKAO_API_KEY=
