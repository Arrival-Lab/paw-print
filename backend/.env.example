# ─── Database ────────────────────────────────────────────────────────────────
# 로컬 Docker 기본값 (docker-compose-local.yml 기준)
DB_USER=dev
DB_PASSWORD=dev

# ─── JWT ─────────────────────────────────────────────────────────────────────
# 256bit(32자) 이상 랜덤 문자열. 운영 환경에서는 반드시 변경.
# 생성 예시: openssl rand -hex 32
JWT_SECRET=

# ─── Claude Vision API (OCR) ─────────────────────────────────────────────────
# https://console.anthropic.com → API Keys
CLAUDE_API_KEY=

# ─── AWS S3 (파일 업로드) ─────────────────────────────────────────────────────
AWS_ACCESS_KEY=AKIA...
AWS_SECRET_KEY=your-secret-key
AWS_S3_BUCKET=pawprint-files
AWS_REGION=ap-northeast-2

# ─── Kakao Local API (응급병원 검색) ──────────────────────────────────────────
# https://developers.kakao.com → 내 애플리케이션 → REST API 키
# 절대 프론트엔드에 노출 금지
KAKAO_API_KEY=KakaoAK_...

# ─── Firebase FCM (푸시 알림) ─────────────────────────────────────────────────
# Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성 후 경로 지정
FCM_CREDENTIALS_PATH=/path/to/firebase-credentials.json

# ─── Google OAuth2 ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
