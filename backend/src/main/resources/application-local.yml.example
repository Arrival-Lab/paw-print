spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/pawprintdb
    username: ${DB_USER:dev}
    password: ${DB_PASSWORD:dev}
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: true
    properties:
      hibernate:
        format_sql: true

  flyway:
    enabled: true
    baseline-on-migrate: false

# ─── JWT ─────────────────────────────────────────────────────────────────────
jwt:
  secret: ${JWT_SECRET}
  access-expiration: 86400000
  refresh-expiration: 2592000000

cors:
  allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:8081,http://localhost:19006,http://10.0.2.2:8081}

# ─── Gemini API (OCR) ────────────────────────────────────────────────────────
gemini:
  api-key: ${GEMINI_API_KEY:}

# ─── AWS S3 ──────────────────────────────────────────────────────────────────
aws:
  s3:
    bucket: ${AWS_S3_BUCKET:pawprint-files}
    region: ${AWS_REGION:ap-northeast-2}
    access-key: ${AWS_ACCESS_KEY:}
    secret-key: ${AWS_SECRET_KEY:}

# ─── Kakao (백엔드 전용) ──────────────────────────────────────────────────────
kakao:
  api-key: ${KAKAO_API_KEY:}

# ─── 날씨 / 대기오염 (data.go.kr 공공데이터) ─────────────────────────────────
# provider: mock(기본, 가짜 데이터) | kma(기상청+에어코리아 실 연동)
# 키 없으면 mock 으로 자동 폴백되도록 KmaWeatherProvider 가 빈 키 감지
weather:
  provider: ${WEATHER_PROVIDER:mock}
  kma:
    service-key: ${KMA_SERVICE_KEY:}
  keco:
    service-key: ${KECO_SERVICE_KEY:}

# ─── Firebase FCM ────────────────────────────────────────────────────────────
firebase:
  credentials-path: ${FCM_SERVICE_ACCOUNT_KEY:}

# ─── OAuth2 ──────────────────────────────────────────────────────────────────
google:
  client-id: ${GOOGLE_CLIENT_ID:}
  play:
    credentials-path: ${PLAY_DEVELOPER_API_JSON:}
    package-name: com.arrivallab.pawprint

apple:
  team-id: RNBB5R7469
  key-id: ${APPLE_KEY_ID:}
  key-path: src/main/resources/apple-key.p8
  bundle-id: com.arrivallab.pawprint
  shared-secret: ${APPLE_SHARED_SECRET:}
