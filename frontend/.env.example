# ─── API ──────────────────────────────────────────────────────────────────────
# 모든 테스트는 배포된 백엔드 사용. 로컬 백엔드 띄울 때만 LAN IP 로 덮어쓸 것.
EXPO_PUBLIC_API_BASE_URL=https://api.pawprintapp.link

# ─── Google OAuth2 ─────────────────────────────────────────────────────────────
# Google Cloud Console > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID
EXPO_PUBLIC_GOOGLE_CLIENT_ID=          # 웹 클라이언트 ID (Expo Go 개발용)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=      # iOS 클라이언트 ID
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=  # Android 클라이언트 ID

# ─── Kakao Map (병원 찾기 지도) ─────────────────────────────────────────────────
# Kakao 콘솔 > 내 앱 > 앱 키 > JavaScript 키. Web 플랫폼에 https://pawprintapp.link 등록 필요.
# ※ 이건 도메인 제한 걸린 *지도 JS 키* — 백엔드 검색/OCR 에 쓰는 REST 키와 별개라 노출 OK (CLAUDE.md 규칙 5 예외).
EXPO_PUBLIC_KAKAO_JS_KEY=

# ─── 주의사항 ──────────────────────────────────────────────────────────────────
# - EXPO_PUBLIC_ 접두사가 붙은 변수만 앱 번들에 포함됨 (클라이언트 노출)
# - 카카오 REST API 키, Firebase 서비스 계정 키 등 민감 정보는 절대 여기에 넣지 말 것 (백엔드 전용)
# - 단, 위 KAKAO_JS_KEY (지도 JS 키) 는 도메인 제한 클라이언트 키라 예외
# - 실제 값은 Confluence > 공유정보 페이지 참고
