# ─── API ──────────────────────────────────────────────────────────────────────
# 개발: http://localhost:8080  |  운영: https://api.pawprint.app
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# ─── Google OAuth2 ─────────────────────────────────────────────────────────────
# Google Cloud Console > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID
EXPO_PUBLIC_GOOGLE_CLIENT_ID=          # 웹 클라이언트 ID (Expo Go 개발용)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=      # iOS 클라이언트 ID
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=  # Android 클라이언트 ID

# ─── 주의사항 ──────────────────────────────────────────────────────────────────
# - EXPO_PUBLIC_ 접두사가 붙은 변수만 앱 번들에 포함됨 (클라이언트 노출)
# - 카카오 API 키, Firebase 서비스 계정 키 등 민감 정보는 절대 여기에 넣지 말 것
# - 실제 값은 Confluence > 공유정보 페이지 참고
