# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── Expo ─────────────────────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# EAS Build
.eas/
eas-build-pre-install.sh

# ─── Environment Variables ────────────────────────────────────────────────────
# 절대 커밋 금지 — .env.example 만 커밋
.env
.env.*
!.env.example

# ─── Native Generated ─────────────────────────────────────────────────────────
# expo prebuild 생성 파일 (디렉토리 자체는 유지 — FCM 설정 파일 보관용)
/ios/Pods/
/ios/build/
/ios/*.xcworkspace
/ios/*.xcodeproj
/ios/Podfile
/android/.gradle/
/android/app/build/
/android/build/
/android/gradlew
/android/gradlew.bat
/android/gradle/
.kotlin/

# Android
local.properties
*.orig.*

# iOS
*.jks
*.p8
*.p12
*.key
*.mobileprovicion
Podfile.lock
.bundle/

# ─── Firebase / Google Services ───────────────────────────────────────────────
# 클라이언트 식별자 파일은 git tracked — EAS Build 가 git 기반이라 필요.
# (firebase plist/json 은 앱 ipa 에 포함되어 배포되므로 클라이언트 측에서는 비밀이 아님.
#  단 repo public 화 시점에 firebase project 접근 정책·App Check 반드시 점검.)
# 진짜 비밀 (firebase-admin, service account) 은 절대 커밋 금지:
*-firebase-adminsdk-*.json
firebase-credentials.json

# ─── Signing & Certificates ───────────────────────────────────────────────────
*.mobileprovision
*.pem
*.cer
*.certSigningRequest
credentials.json

# ─── Metro ────────────────────────────────────────────────────────────────────
.metro-health-check*

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
logs/

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Test & Coverage ──────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Editor ───────────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
