# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── Expo ─────────────────────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# EAS Build
.eas/
eas-build-pre-install.sh

# ─── Environment Variables ────────────────────────────────────────────────────
# 절대 커밋 금지 — .env.example 만 커밋
.env
.env.*
!.env.example

# ─── Native Generated ─────────────────────────────────────────────────────────
# expo prebuild 생성 파일 (디렉토리 자체는 유지 — FCM 설정 파일 보관용)
/ios/Pods/
/ios/build/
/ios/*.xcworkspace
/ios/*.xcodeproj
/ios/Podfile
/android/.gradle/
/android/app/build/
/android/build/
/android/gradlew
/android/gradlew.bat
/android/gradle/
.kotlin/

# Android
local.properties
*.orig.*

# iOS
*.jks
*.p8
*.p12
*.key
*.mobileprovicion
Podfile.lock
.bundle/

# ─── Firebase / Google Services ───────────────────────────────────────────────
# 절대 커밋 금지 — 파일은 로컬에만 보관, 팀 공유는 암호화된 채널 사용
# app.json은 frontend/ root 위치(./google-services.json, ./GoogleService-Info.plist)를 참조.
# prebuild --clean이 android/·ios/를 통째로 지우는 문제를 피하기 위함.
google-services.json
GoogleService-Info.plist
android/app/google-services.json
ios/GoogleService-Info.plist
*-firebase-adminsdk-*.json
firebase-credentials.json

# ─── Signing & Certificates ───────────────────────────────────────────────────
*.mobileprovision
*.pem
*.cer
*.certSigningRequest
credentials.json

# ─── Metro ────────────────────────────────────────────────────────────────────
.metro-health-check*

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
logs/

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Test & Coverage ──────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Editor ───────────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
