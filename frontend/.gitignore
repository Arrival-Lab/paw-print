# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── Expo ─────────────────────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# EAS Build
.eas/
eas-build-pre-install.sh

# 로컬 빌드 산출물 — EAS 크레딧 소진 시 로컬 빌드한 IPA/APK/AAB. 절대 커밋 금지.
*.ipa
*.apk
*.aab

# ─── Environment Variables ────────────────────────────────────────────────────
# 절대 커밋 금지 — .env.example 만 커밋
.env
.env.*
!.env.example

# ─── Native Generated ─────────────────────────────────────────────────────────
# android/·ios/ 전체 git 추적 제외 — EAS Build 서버가 매 빌드마다 prebuild 새로 실행.
# app.json + plugins 가 유일한 네이티브 설정 소스. 로컬 수정 필요 시 app.json 또는 config plugin 으로.
# FCM/Apple credential 파일은 frontend/ 루트(google-services.json, GoogleService-Info.plist)에
# 두고 prebuild 가 자동으로 android/app/, ios/ 로 복사.
/android/
/ios/
.kotlin/

# Android
local.properties
*.orig.*

# iOS
*.jks
*.p8
*.p12
*.key
*.mobileprovicion
Podfile.lock
.bundle/

# ─── Firebase / Google Services ───────────────────────────────────────────────
# 클라이언트 식별자 파일은 git tracked — EAS Build 가 git 기반이라 필요.
# (firebase plist/json 은 앱 ipa 에 포함되어 배포되므로 클라이언트 측에서는 비밀이 아님.
#  단 repo public 화 시점에 firebase project 접근 정책·App Check 반드시 점검.)
# 진짜 비밀 (firebase-admin, service account) 은 절대 커밋 금지:
*-firebase-adminsdk-*.json
firebase-credentials.json

# ─── Signing & Certificates ───────────────────────────────────────────────────
*.mobileprovision
*.pem
*.cer
*.certSigningRequest
credentials.json

# ─── Metro ────────────────────────────────────────────────────────────────────
.metro-health-check*

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
logs/

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Test & Coverage ──────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Editor ───────────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
