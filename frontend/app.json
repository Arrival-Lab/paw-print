{
  "expo": {
    "name": "발자국",
    "slug": "paw-print",
    "scheme": "pawprint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4A8B8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arrivallab.pawprint",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:pawprintapp.link"],
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"],
        "NSMicrophoneUsageDescription": "진료 직후 녹음한 내용을 AI가 텍스트로 정리해 진료기록 작성을 도와드려요."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.arrivallab.pawprint",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": ["RECORD_AUDIO"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pawprintapp.link",
              "pathPrefix": "/invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F4A8B8"
        }
      ],
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "진료 직후 녹음한 내용을 AI가 텍스트로 정리해 진료기록 작성을 도와드려요."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "진료기록·다이어리·커뮤니티에 사진을 첨부하고 OCR로 진료 영수증을 인식하기 위해 사진 라이브러리 접근이 필요해요.",
          "cameraPermission": "진료 영수증을 촬영해 AI가 진료기록을 자동으로 정리하도록 카메라 접근이 필요해요."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f13207b2-4fb8-4e7b-aecd-f12c4d9b9b34"
      }
    },
    "owner": "arrival-lab",
    "updates": {
      "url": "https://u.expo.dev/f13207b2-4fb8-4e7b-aecd-f12c4d9b9b34"
    }
  }
}
